{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "rspack.config.mjs"
      }
    },
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true
  }
}
